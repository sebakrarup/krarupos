# G502 X LIGHTSPEED (el mouse de Seba): rueda en resolución normal (punto muerto)
# al conectar. Solo si el mouse está despierto (online=1): consultarlo dormido hace
# que el receptor lo reanuncie, cambia la batería y la regla se dispara en bucle.
# En PCs sin este mouse no hace nada. Ver /usr/libexec/krarupos-g502-rueda-auto
SUBSYSTEM=="power_supply", KERNEL=="hidpp_battery_*", ATTR{model_name}=="G502 X LIGHTSPEED", ATTR{online}=="1", ACTION=="add|change", RUN+="/usr/bin/systemd-run --no-block --quiet --collect --setenv=ACTION=$env{ACTION} --setenv=DEVPATH=$env{DEVPATH} /usr/libexec/krarupos-g502-rueda-auto"
