[Unit]
# Solo usuarios normales: no en el de la pantalla de inicio (plasmalogin).
ConditionUser=!@system
Description=Ocultar la partición del sistema cuando KDE crea los Lugares

[Path]
# KDE crea este archivo la primera vez que se abre Dolphin o un diálogo de archivos.
PathChanged=%h/.local/share/user-places.xbel
Unit=krarupos-ocultar-disco-sistema.service

[Install]
WantedBy=default.target
