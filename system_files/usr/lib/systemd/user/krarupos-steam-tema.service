[Unit]
Description=Tema Dracula para Steam (AdwSteamGtk)

[Service]
# La primera vez espera a AdwSteamGtk y a Steam, así que no debe bloquear el
# inicio de sesión.
Type=simple
ExecStart=/usr/libexec/krarupos-steam-tema
# Sin internet o con GitHub caído se reintenta.
Restart=on-failure
RestartSec=5min

[Install]
WantedBy=default.target
