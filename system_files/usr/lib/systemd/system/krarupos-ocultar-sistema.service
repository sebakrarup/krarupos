[Unit]
Description=Esconder la raíz y /boot de los dispositivos de KDE y darle ícono al disco del sistema
After=local-fs.target systemd-udevd.service
Before=udisks2.service display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/krarupos-ocultar-sistema

[Install]
WantedBy=multi-user.target
