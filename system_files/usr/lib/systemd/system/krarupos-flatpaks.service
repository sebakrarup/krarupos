[Unit]
Description=Instalar las apps Flatpak de krarupOS
Wants=network-online.target
After=network-online.target

[Service]
# simple y no oneshot: un oneshot no cuenta como iniciado hasta terminar, y
# eso dejaba el arranque a medias (multi-user.target sin llegar) mientras se
# bajaban las apps; lactd y todo lo que va After=multi-user.target esperaba
# (2026-10-27, LACT sin funcionar con la instalación pegada en Kodi).
Type=simple
ExecStart=/usr/libexec/krarupos-flatpaks
Restart=on-failure
RestartSec=5min

[Install]
WantedBy=multi-user.target
