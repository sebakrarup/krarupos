#!/usr/bin/bash
# Instala Proton-CachyOS "Latest" con ProtonPlus, una sola vez por usuario,
# igual que elegirlo en ProtonPlus: después ProtonPlus lo actualiza.
# Si alguien lo desinstala, no se vuelve a instalar.
set -euo pipefail

marca=${XDG_STATE_HOME:-$HOME/.local/state}/krarupos/proton-cachyos
[[ -f "$marca" ]] && exit 0

herramientas=$HOME/.local/share/Steam/compatibilitytools.d
# ProtonPlus distingue la variante solo por el nombre de la carpeta: la v3
# elegida en su ventana queda en "...Latest-x86_64_v3" (en Steam se ve igual,
# "Proton-CachyOS Latest").
normal="$herramientas/Proton-CachyOS Latest"
v3="$herramientas/Proton-CachyOS Latest-x86_64_v3"

# ProtonPlus lo instala krarupos-flatpaks y la carpeta de Steam aparece
# cuando Steam abre por primera vez.
until flatpak info com.vysp3r.ProtonPlus &>/dev/null && [[ -d $HOME/.local/share/Steam ]]; do
    sleep 30
done

if [[ ! -f $v3/.protonplus && ! -f $normal/.protonplus ]]; then
    echo "Instalando Proton-CachyOS Latest con ProtonPlus"
    flatpak run com.vysp3r.ProtonPlus install steam-system proton-cachyos latest
fi

# Por comando, ProtonPlus instala siempre la variante x86-64. Se cambia por la
# v3 del mismo release (AVX2: casi todas las CPUs desde 2015; en un PC más viejo
# se usa otro Proton) y se anota en .protonplus para que ProtonPlus la siga
# actualizando.
if [[ -f $normal/.protonplus ]] && grep -q '"variant_id":"x86-64"' "$normal/.protonplus"; then
    echo "Cambiando a la variante x86-64-v3"
    tag=$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["tag"])' "$normal/.protonplus")
    nombre="proton-${tag}-x86_64_v3"
    url="https://github.com/CachyOS/proton-cachyos/releases/download/$tag/$nombre"
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    curl -fsSL "$url.tar.xz" -o "$tmp/$nombre.tar.xz"
    curl -fsSL "$url.sha512sum" -o "$tmp/$nombre.sha512sum"
    (cd "$tmp" && sha512sum -c --quiet "$nombre.sha512sum")
    tar -xJf "$tmp/$nombre.tar.xz" -C "$tmp"
    # Se quedan los archivos de ProtonPlus (el nombre "Latest" en Steam y su ficha).
    mv "$normal/.protonplus" "$normal/compatibilitytool.vdf" "$tmp/$nombre/"
    sed -i 's/"variant_id":"x86-64"/"variant_id":"x86-64-v3"/' "$tmp/$nombre/.protonplus"
    rm -rf "$normal"
    mv "$tmp/$nombre" "$normal"
    echo "Listo: $nombre"
fi

# La v3 va en la carpeta que usa ProtonPlus para esa variante (también arregla
# las instalaciones anteriores, que la dejaban en "Proton-CachyOS Latest").
if [[ -f $normal/.protonplus ]] && grep -q '"variant_id":"x86-64-v3"' "$normal/.protonplus" && [[ ! -e $v3 ]]; then
    mv "$normal" "$v3"
fi

# Si Steam está cerrado ahora, queda de predeterminado al tiro; si no, antes
# de la próxima sesión (krarupos-proton-default.service).
/usr/libexec/krarupos-proton-default

mkdir -p "$(dirname "$marca")"
touch "$marca"
