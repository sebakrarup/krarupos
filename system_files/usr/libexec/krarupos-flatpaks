#!/usr/bin/bash
# Instala las apps de /usr/share/krarupos/flatpaks.txt, cada una una sola vez
# por computador: las que ya se instalaron quedan anotadas y, si alguien las
# desinstala, no vuelven (ni al actualizar ni al cambiar la lista).
set -euo pipefail

lista=/usr/share/krarupos/flatpaks.txt

# Políticas y preferencias de Firefox (Flatpak): se leen desde esta extensión en /var, así
# que se copian en cada arranque, igual que Bazzite hace con sus preferencias.
politicas=/var/lib/flatpak/extension/org.mozilla.firefox.systemconfig/x86_64/stable/policies
mkdir -p "$politicas"
cp -f /usr/share/krarupos/firefox-policies.json "$politicas/policies.json"
preferencias=/var/lib/flatpak/extension/org.mozilla.firefox.systemconfig/x86_64/stable/defaults/pref
mkdir -p "$preferencias"
cp -f /usr/share/krarupos/firefox-prefs.js "$preferencias/02-krarupos.js"

# Apps que ya pasaron por aquí (instaladas por este servicio o que ya estaban).
anotadas=/var/lib/krarupos/flatpaks-instaladas
mkdir -p "$(dirname "$anotadas")"
touch "$anotadas"
instaladas=$(flatpak list --system --columns=application)

# La versión anterior guardaba solo la suma de la lista.
rm -f /var/lib/krarupos/flatpaks.sha256

faltan=()
while read -r app; do
    app=${app%%#*}
    app=${app//[[:space:]]/}
    [[ -z "$app" ]] && continue
    id=${app%%//*}
    grep -qxF "$id" "$anotadas" && continue
    # Ya instalada (por ejemplo, a mano antes de agregarla a la lista).
    if grep -qxF "$id" <<<"$instaladas"; then
        echo "$id" >>"$anotadas"
    else
        faltan+=("$app")
    fi
done <"$lista"

if ((!${#faltan[@]})); then
    echo "No hay apps nuevas en la lista; nada que hacer."
    exit 0
fi

flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

# A veces una descarga de Flathub se queda colgada para siempre (2026-10-27:
# WhatSie detenida sin bajar nada y todas las demás esperando). Con un tope por
# app se sigue con la siguiente y la que faltó se reintenta más tarde.
instalar() {
    timeout 10m flatpak install --system --noninteractive --or-update flathub "$1" || return 1
    # lactd no arranca mientras LACT no esté instalada (ConditionPathExists).
    if [[ $1 == io.github.ilya_zlobintsev.LACT ]]; then
        systemctl start --no-block lactd.service || true
    fi
}

echo "Instalando: ${faltan[*]}"
# Una por una, para que una app que ya no exista en Flathub no
# impida instalar las demás.
fallaron=0
reparado=0
for app in "${faltan[@]}"; do
    instalar "$app" && echo "${app%%//*}" >>"$anotadas" && continue
    # Si se apagó el PC a mitad de una descarga, queda un runtime a medias
    # ("No such metadata object") y todo lo que lo usa falla. Se repara
    # una vez y se reintenta.
    if ((!reparado)); then
        reparado=1
        flatpak repair --system
        instalar "$app" && echo "${app%%//*}" >>"$anotadas" && continue
    fi
    echo "No se pudo instalar $app" >&2
    fallaron=1
done
# Si algo falló (por ejemplo, sin internet), esa app no queda anotada
# y se reintenta en el próximo arranque.
exit "$fallaron"
